{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-design-agent.local/schemas/entity-candidate.schema.json",
  "title": "Entity Candidate",
  "description": "Candidate canonical entity match emitted by an adapter or entity-resolution stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type", "display_name", "match_confidence"],
  "properties": {
    "canonical_entity_id": { "type": ["string", "null"] },
    "entity_type": {
      "type": "string",
      "enum": ["manufacturer", "product_family", "product_sku", "cpu", "motherboard", "gpu", "memory_module", "ssd", "hdd", "psu", "case", "cooler", "nic", "wifi_module", "firmware_record", "driver_record", "benchmark_suite", "benchmark_result", "retailer", "marketplace_listing", "lifecycle_record", "repairability_record", "protocol_standard", "socket", "chipset", "form_factor", "connector"]
    },
    "display_name": { "type": "string" },
    "vendor_name": { "type": ["string", "null"] },
    "model_family": { "type": ["string", "null"] },
    "mpn": { "type": ["string", "null"] },
    "upc": { "type": ["string", "null"] },
    "ean": { "type": ["string", "null"] },
    "pci_id": { "type": ["string", "null"] },
    "match_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "matching_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires_manual_review": { "type": "boolean", "default": false }
  }
}
